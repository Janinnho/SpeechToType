    "buttonDictationTargetDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin der Text geht, wenn du auf der Startseite mit dem Aufnahmebutton diktierst. Diktate per Tastenkürzel werden immer in die aktive App eingefügt, und jedes Diktat landet zusätzlich im Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the text goes when you dictate with the record button on the start page. Dictations via keyboard shortcut are always inserted into the active app, and every dictation is also saved to the history."
          }
        }
      }
    },
