    "geminiDictionaryVocabularyNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörterbuch-Wörter werden als Custom Vocabulary übergeben (max. 1.000). Die Freitext-Anweisungen nutzt Gemini 3.5 Transcribe nicht – das Modell nimmt keinen Prompt entgegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictionary words are passed as custom vocabulary (max. 1,000). Gemini 3.5 Transcribe ignores the free-text instructions – the model takes no prompt."
          }
        }
      }
    },
    "geminiLiveDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Text live in der Overlay-Vorschau, während du sprichst. Erst beim Loslassen der Taste wird der komplette, korrekt formatierte Text auf einmal eingefügt. Eine Live-Sitzung ist auf 10 Minuten begrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the text live in the overlay preview while you speak. The complete, correctly formatted text is inserted at once when you release the key. A live session is limited to 10 minutes."
          }
        }
      }
    },
