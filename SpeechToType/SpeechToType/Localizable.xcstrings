    "azureRealtimeDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Text live in der Overlay-Vorschau, während du sprichst. Erst wenn du die Taste loslässt (bzw. die Aufnahme stoppst), wird der komplette, korrekt formatierte Text auf einmal eingefügt. Nutzt Azure-Standardmodelle – nicht MAI-Transcribe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the text live in the overlay preview while you speak. Only when you release the key (or stop recording) is the complete, correctly formatted text inserted at once. Uses Azure standard models – not MAI-Transcribe."
          }
        }
      }
    },
